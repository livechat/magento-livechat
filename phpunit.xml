<phpunit
	bootstrap="build/dev/vendor/autoload.php"
	colors="true"
	cacheDirectory="build/dev/.phpunit.cache"
	failOnWarning="true"
	failOnRisky="true"
>
	<testsuites>
		<testsuite name="unit">
			<directory suffix="Test.php">Test/Unit</directory>
			<!-- Needs real Magento classes: run with pnpm test:magento -->
			<exclude>Test/Unit/Controller</exclude>
		</testsuite>
	</testsuites>
</phpunit>
