<?xml version="1.0"?>
<ruleset name="LiveChat Magento module">
	<description>Magento 2 coding standard for the LiveChat module.</description>

	<file>../plugin</file>
	<exclude-pattern>*/vendor/*</exclude-pattern>

	<arg name="extensions" value="php,phtml"/>
	<arg name="colors"/>
	<arg value="p"/>

	<config name="testVersion" value="8.1-"/>

	<rule ref="Magento2"/>
	<rule ref="PHPCompatibility"/>

	<!-- The module and .editorconfig use tab indentation; Magento2 expects spaces. -->
	<rule ref="Generic.WhiteSpace.DisallowTabIndent">
		<severity>0</severity>
	</rule>
	<rule ref="Generic.WhiteSpace.ScopeIndent">
		<severity>0</severity>
	</rule>
	<rule ref="Squiz.Functions.MultiLineFunctionDeclaration.Indent">
		<severity>0</severity>
	</rule>

	<!-- Templates and XML schema headers contain long URLs that cannot be wrapped. -->
	<rule ref="Generic.Files.LineLength">
		<exclude-pattern>*.phtml</exclude-pattern>
		<exclude-pattern>*.xml</exclude-pattern>
	</rule>
</ruleset>
