<phpunit
	bootstrap="vendor/autoload.php"
	colors="true"
	cacheDirectory=".phpunit.cache"
	failOnWarning="true"
	failOnRisky="true"
>
	<testsuites>
		<testsuite name="unit">
			<directory suffix="Test.php">../../Test/Unit</directory>
			<!-- Needs real Magento classes: run with pnpm test:magento -->
			<exclude>../../Test/Unit/Controller</exclude>
		</testsuite>
	</testsuites>
</phpunit>
