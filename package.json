{
    "name": "magento-livechat-plugin",
    "version": "1.0.0",
    "description": "Magento 2 module for LiveChat",
    "private": true,
    "scripts": {
        "prepare": "husky",
        "run-env": "zx ./scripts/magento/run.mjs",
        "magento-minimum": "zx ./scripts/magento/run.mjs --php $npm_package_config_php_minimum_ver --magento $npm_package_config_magento_minimum_ver",
        "magento-latest": "zx ./scripts/magento/run.mjs --php $npm_package_config_php_latest_ver --magento $npm_package_config_magento_latest_ver",
        "cleanup": "zx ./scripts/magento/cleanup.mjs",
        "composer": "zx ./scripts/php/composer.mjs",
        "test": "zx ./scripts/php/composer.mjs test",
        "phpcs": "zx ./scripts/php/composer.mjs static-analysis",
        "phpcbf": "zx ./scripts/php/composer.mjs fix-static-analysis"
    },
    "license": "ISC",
    "dependencies": {
        "zx": "^8.8.5"
    },
    "config": {
        "php_latest_ver": "8.4",
        "php_minimum_ver": "8.1",
        "magento_latest_ver": "2.4.8",
        "magento_minimum_ver": "2.4.6"
    },
    "devDependencies": {
        "husky": "^9.1.7"
    }
}
